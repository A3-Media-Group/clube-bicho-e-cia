# Gerado por build.mjs — não edite à mão.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Arquivos de desenvolvimento não são públicos.
RewriteRule ^(src|scripts|tests|docs|data|node_modules)(/|$) - [R=404,L]
RewriteRule ^(build\.mjs|package(-lock)?\.json|README\.md|LEIA-ME\.md)$ - [R=404,L]
# Arquivos ocultos (ex.: .git), exceto .well-known (validação do certificado SSL).
RewriteRule (^|/)\.(?!well-known/) - [R=404,L]

# URLs antigas → novas (301 direto para https sem www, sem cadeia).
RewriteRule ^idade\.html$ https://clubebichoecia.com.br/ferramentas/idade-do-pet-em-anos-humanos/ [R=301,L]
RewriteRule ^racao\.html$ https://clubebichoecia.com.br/ferramentas/calculadora-de-racao-para-caes-e-gatos/ [R=301,L]
RewriteRule ^alimentos\.html$ https://clubebichoecia.com.br/ferramentas/alimentos-proibidos-para-caes-e-gatos/ [R=301,L]
RewriteRule ^gastos\.html$ https://clubebichoecia.com.br/ferramentas/custo-mensal-do-pet/ [R=301,L]
RewriteRule ^agenda\.html$ https://clubebichoecia.com.br/ferramentas/agenda-de-cuidados-do-pet/ [R=301,L]
RewriteRule ^nomes\.html$ https://clubebichoecia.com.br/ferramentas/nomes-para-cachorro-e-gato/ [R=301,L]
RewriteRule ^vacinacao-antirrabica\.html$ https://clubebichoecia.com.br/guias/vacina-antirrabica-para-caes-e-gatos/ [R=301,L]
RewriteRule ^alimentacao-e-porcoes\.html$ https://clubebichoecia.com.br/guias/quanto-de-racao-dar-ao-cachorro-e-ao-gato/ [R=301,L]
RewriteRule ^alimentos-perigosos\.html$ https://clubebichoecia.com.br/guias/alimentos-perigosos-para-caes-e-gatos/ [R=301,L]
RewriteRule ^peso-e-condicao-corporal\.html$ https://clubebichoecia.com.br/guias/peso-ideal-e-condicao-corporal-do-cachorro/ [R=301,L]
RewriteRule ^idade-caes-gatos\.html$ https://clubebichoecia.com.br/guias/idade-de-cachorro-e-gato-em-anos-humanos/ [R=301,L]
RewriteRule ^sobre\.html$ https://clubebichoecia.com.br/sobre/ [R=301,L]
RewriteRule ^privacidade\.html$ https://clubebichoecia.com.br/privacidade/ [R=301,L]
RewriteRule ^termos\.html$ https://clubebichoecia.com.br/termos/ [R=301,L]
RewriteRule ^creditos\.html$ https://clubebichoecia.com.br/creditos/ [R=301,L]

# http → https e www → sem www (301).
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^clubebichoecia\.com\.br$ [NC]
RewriteRule ^ https://clubebichoecia.com.br%{REQUEST_URI} [R=301,L]

# Qualquer .../index.html → .../ (301).
RewriteCond %{THE_REQUEST} \s/+((?:[^?\s]*/)?)index\.html[?\s] [NC]
RewriteRule ^ /%1 [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
AddType application/manifest+json .webmanifest
AddType image/webp .webp
AddType text/javascript .js
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
# Arquivos com hash no nome e imagens: 1 ano. HTML, XML e TXT: cache curto.
<FilesMatch "\.[0-9a-f]{8}\.(css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(webp|jpe?g|png|svg|ico)$">
Header set Cache-Control "public, max-age=31536000"
</FilesMatch>
<FilesMatch "\.(html|xml|txt|webmanifest)$">
Header set Cache-Control "public, max-age=600, must-revalidate"
</FilesMatch>
</IfModule>
